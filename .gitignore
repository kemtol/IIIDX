# Heavy model artifacts. Keep small, reproducibility-critical artifacts in git:
# model_lightgbm_*.txt, metrics/feature CSVs, report PNGs, and Monte Carlo summaries.
# Large parquet outputs should move to DVC/LFS when a model is locked.
model/**/valid_predictions.parquet
model/**/portfolio_*.parquet
model/**/*.log
model/*/_ARCH/
model/*/_BAK/

# Misplaced edges/model/ (artifact dari training cwd bug)
edges/model/**/valid_predictions.parquet
edges/model/**/portfolio_*.parquet

